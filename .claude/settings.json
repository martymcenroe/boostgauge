{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /c/Users/mcwiz/Projects/boostgauge/.claude/hooks/bash-gate.sh",
            "timeout": 5,
            "description": "Bash Command Gate (blocks &&, |, ;, destructive git)"
          },
          {
            "type": "command",
            "command": "bash /c/Users/mcwiz/Projects/boostgauge/.claude/hooks/secret-guard.sh",
            "timeout": 5,
            "description": "Secret Guard (blocks secret leaks to stdout)"
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|Grep|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /c/Users/mcwiz/Projects/boostgauge/.claude/hooks/secret-file-guard.sh",
            "timeout": 5,
            "description": "Secret File Guard (blocks file tools on .env, .dev.vars, .aws/credentials)"
          }
        ]
      }
    ],
    "PostToolUse": []
  }
}
